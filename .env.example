PORT=3000
NODE_ENV=development

# Database Configuration
DB_URL=postgresql://your_db_user:your_db_password@localhost:5432/resume_parser_db
DB_SSL=false

# Optional fallback when DB_URL is not provided.
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=resume_parser_db

# Separate database used only by `npm test`. The tests empty every table in it,
# so it must never point at the application database.
TEST_DB_URL=postgresql://your_db_user:your_db_password@localhost:5432/resume_parser_test

# Comma-separated frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://resumeintelligenceplatform-frontend.netlify.app,https://deluxe-mermaid-dc9dad.netlify.app,https://eclectic-quokka-cda4c7.netlify.app

# Where uploaded files are stored (default: ./uploads).
# UPLOAD_DIR=./uploads

# Rate limit for upload/parse requests, per client IP. RATE_LIMIT_MAX=0 disables it.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=30

# Groq LLM Resume Parsing
# When GROQ_API_KEY is present, the service parses resumes with Groq first.
# If Groq fails or reaches API limits, the service falls back to rule-based parsing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MAX_RESUME_CHARS=30000
GROQ_TIMEOUT_MS=30000
